# LLM Provider — Free Google AI Studio key (recommended) or Anthropic Claude key
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Telegram — get from @BotFather
TELEGRAM_BOT_TOKEN=

# Postgres (use SQLite locally by swapping the provider in prisma/schema.prisma
# to "sqlite" and DATABASE_URL="file:./prisma/dev.db" while you're building — switch
# back to Postgres for the deployed/reviewed version)
DATABASE_URL="postgresql://user:password@localhost:5432/kirana"

# Shop details baked into invoices — also settable/overridable via chat
# ("set my shop name to X", "my GSTIN is Y") which persists as a Preference row
SHOP_NAME="My Kirana Store"
SHOP_GSTIN=
SHOP_ADDRESS=
